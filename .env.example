# LifeTrack environment variables — NAMES ONLY, no values.
# Recover real values any time with:  npx vercel env pull .env.local
# (Vercel project settings is the source of truth for all of these.)

# --- Firebase web config (public by design — Firebase Console → Project settings) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Server secrets (NEVER commit values) ---
# Full service-account JSON as one line — GCP Console → IAM → Service Accounts → Keys
FIREBASE_SERVICE_ACCOUNT=
# Google Sheet id for the daily backup (docs.google.com/spreadsheets/d/<ID>/edit)
BACKUP_SHEET_ID=
# Shared secret for /api/backup and /api/notify cron calls — any random string
CRON_SECRET=

# --- Web Push (regenerate pair: npx web-push generate-vapid-keys) ---
# Note: a new key pair invalidates existing push subscriptions (users re-enable)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
